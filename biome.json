{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off" },
      "complexity": { "noImportantStyles": "off", "useLiteralKeys": "off" },
      "suspicious": { "noArrayIndexKey": "off" }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "files": {
    "includes": ["src/**/*.{ts,tsx}", "src/styles.css"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
